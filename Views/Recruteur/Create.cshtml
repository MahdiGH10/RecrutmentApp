@model RecruitApp.ViewModels.OffreFormViewModel
@{
    ViewData["Title"] = "Nouvelle offre";
    var minExpiration = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<section class="page-hero dashboard-hero">
    <div>
        <p class="eyebrow">Espace recruteur</p>
        <h1>Publier une offre</h1>
        <p class="hero-copy">Renseignez les informations du poste pour commencer à recevoir des candidatures qualifiées.</p>
    </div>
    <div class="page-actions">
        <a asp-action="MesOffres" class="btn btn-secondary">Retour aux offres</a>
    </div>
</section>

<div class="card-surface form-card">
    <form asp-action="Create" method="post" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-lg-8">
                <label asp-for="Titre" class="form-label"></label>
                <input asp-for="Titre" class="form-control form-control-lg" placeholder="Ex: Développeur Full Stack" />
                <span asp-validation-for="Titre" class="text-danger small"></span>
            </div>
            <div class="col-lg-4">
                <label asp-for="Zone" class="form-label"></label>
                <input asp-for="Zone" class="form-control form-control-lg" placeholder="Tunis" />
                <span asp-validation-for="Zone" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="7" class="form-control" placeholder="Décrivez le poste, les responsabilités et le profil recherché..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-3">
                <label asp-for="SalaireMin" class="form-label"></label>
                <input asp-for="SalaireMin" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="SalaireMin" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="SalaireMax" class="form-label"></label>
                <input asp-for="SalaireMax" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="SalaireMax" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ExperienceRequise" class="form-label"></label>
                <input asp-for="ExperienceRequise" type="number" class="form-control" />
                <span asp-validation-for="ExperienceRequise" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<RecruitApp.Models.Enums.TypeOffre>()" class="form-select"></select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="ExpiresAt" class="form-label"></label>
                <input asp-for="ExpiresAt" type="datetime-local" class="form-control" min="@minExpiration" />
                <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">La date d'expiration doit être dans le futur, sinon l’offre restera cachée.</small>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Offre active</label>
                </div>
            </div>
        </div>

        <div class="form-actions mt-4">
            <a asp-action="MesOffres" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary">Publier l’offre</button>
        </div>
    </form>
</div>
